{
  "name": "document-engagement-dashboard",
  "version": "1.0.0",
  "description": "Executive viewer engagement dashboard visualizing document read rates, slide drop-off funnels, dwell-time heatmaps, and session metrics.",
  "main": "src/dashboard-engine.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{const f=req.url==='/'?'index.html':req.url.slice(1);const p=path.join(__dirname,f);if(fs.existsSync(p)){res.writeHead(200);fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not found');}}).listen(8087,()=>console.log('Dashboard running at http://localhost:8087'));\""
  },
  "keywords": [
    "document-analytics",
    "engagement-dashboard",
    "dwell-time-heatmap",
    "drop-off-funnel",
    "pitch-deck-analytics",
    "presentation-analytics",
    "sendnow"
  ],
  "author": "SendNow Open Source Team <opensource@sendnow.live>",
  "license": "MIT"
}
